/-! ## Main results -/

/-- **Theorem A (no stabilization for dimension series).** For each `N ≥ 1`,
the explicitly presented Lie ring `FinitePlateau.L N` has `N + 1`
consecutive equal dimension subrings followed by a strict drop. -/
theorem theoremA (N : ℕ) (hN : 1 ≤ N) :
    ∃ m : ℕ, 1 ≤ m ∧
      (∀ q : ℕ, m ≤ q → q ≤ m + N →
        dimensionSubring ℤ (FinitePlateau.L N) q =
          dimensionSubring ℤ (FinitePlateau.L N) m) ∧
      dimensionSubring ℤ (FinitePlateau.L N) (m + N) ≠
        dimensionSubring ℤ (FinitePlateau.L N) (m + N + 1) :=
  FinitePlateau.finite_plateau_publication N hN

/-- **Theorem B (dimension centrality).** This is the manuscript's combined
statement `[δ_n(L),δ_m(L)] ⊆ γ_(n+m)(L)` and
`[δ_n(L),L] = γ_(n+1)(L)`. Lean's lower-central indexing is zero-based. -/
theorem theoremB
    (R : Type u) (L : Type v) [CommRing R] [LieRing L] [LieAlgebra R L]
    (m n : ℕ) (hm : 1 ≤ m) (hn : 1 ≤ n) :
    ⁅dimensionSubring R L n, dimensionSubring R L m⁆ ≤
        lowerCentralSeries R L (n + m - 1) ∧
      ⁅dimensionSubring R L n, (⊤ : LieIdeal R L)⁆ =
        lowerCentralSeries R L n :=
  ⟨bracket_dimensionSubring_le_lowerCentralSeries_of_pos R L hn hm,
    dimensionSubring_bracket_eq_lowerCentralSeries_of_pos R L hn⟩

/-- **Theorem C (metabelian nilpotent vanishing).** If a metabelian Lie ring
has nilpotency class at most `c ≥ 2`, then `δ_(2c-1)(L)=0`. -/
theorem theoremC
    (c : ℕ) (L : Type v) [LieRing L]
    (hc : 2 ≤ c) (hmeta : IsMetabelian L)
    (hclass : lowerCentralSeries ℤ L c = ⊥) :
    dimensionSubring ℤ L (2 * c - 1) = ⊥ :=
  MetabelianTwoFactor.nilpotent_dimensionSubring_eq_bot
    c L hc hmeta hclass

/-- **Corollary D.** For every Lie ring,
`δ_(2c-1)(L) ⊆ γ_(c+1)(L)+L''`; in particular,
`δ_5(L) ⊆ γ_4(L)`. The join `⊔` is the sum of Lie ideals. -/
theorem corollaryD
    (c : ℕ) (L : Type v) [LieRing L] (hc : 2 ≤ c) :
    dimensionSubring ℤ L (2 * c - 1) ≤
        lowerCentralSeries ℤ L c ⊔ LieAlgebra.derivedSeries ℤ L 2 ∧
      dimensionSubring ℤ L 5 ≤ lowerCentralSeries ℤ L 3 :=
  ⟨MetabelianTwoFactor.odd_dimensionSubring_le_lowerCentralSeries_sup_secondDerived
      c L hc,
    MetabelianTwoFactor.dimensionSubring_five_le_lowerCentralSeries_three L⟩

/-- **Corollary E.** A metabelian Lie ring satisfies
`δ_(2c-1)(L) ⊆ γ_(c+1)(L)` for `c ≥ 2`, and consequently
`δ_ω(L)=γ_ω(L)`. -/
theorem corollaryE
    (c : ℕ) (L : Type v) [LieRing L]
    (hc : 2 ≤ c) (hmeta : IsMetabelian L) :
    dimensionSubring ℤ L (2 * c - 1) ≤ lowerCentralSeries ℤ L c ∧
      dimensionSubringOmega ℤ L = lowerCentralSeriesOmega ℤ L := by
  constructor
  · have h :=
      MetabelianTwoFactor.odd_dimensionSubring_le_lowerCentralSeries_sup_secondDerived
        c L hc
    rw [hmeta, sup_bot_eq] at h
    exact h
  · exact MetabelianTwoFactor.dimensionSubringOmega_eq_lowerCentralSeriesOmega
      L hmeta

/-! ## The explicit family used for Theorem A -/

/-- **Lemma `top-layer`.** The explicit ring `L_N` is metabelian of exact
nilpotency class `N+3`, and its last lower-central term is generated by
`u₃`, which has exact additive order `64`. The last two clauses are the
Lean encoding of `γ_(N+3)(L_N)=⟨u₃⟩ ≅ ℤ/64`. -/
theorem lemmaTopLayer (N : ℕ) (hN : 1 ≤ N) :
    IsMetabelian (FinitePlateau.L N) ∧
      (lowerCentralSeries ℤ (FinitePlateau.L N) (N + 2) ≠ ⊥ ∧
        lowerCentralSeries ℤ (FinitePlateau.L N) (N + 3) = ⊥) ∧
      lowerCentralSeries ℤ (FinitePlateau.L N) (N + 2) =
        FinitePlateau.terminalCyclicIdeal N ∧
      addOrderOf (FinitePlateau.u3 N) = 64 ∧
      Nonempty (FinitePlateau.terminalCyclicIdeal N ≃ₗ[ℤ] ZMod 64) := by
  refine ⟨FinitePlateau.isMetabelian N,
    FinitePlateau.exact_lowerCentral_height N hN,
    FinitePlateau.lowerCentralSeries_top_eq_terminalCyclicIdeal N,
    FinitePlateau.addOrderOf_u3_eq_sixtyFour N hN, ?_⟩
  have hspan :
      (FinitePlateau.terminalCyclicIdeal N).toSubmodule =
        ℤ ∙ FinitePlateau.u3 N := by
    apply le_antisymm
    · intro z hz
      obtain ⟨η, rfl⟩ :=
        (FinitePlateau.mem_terminalCyclicIdeal_iff_exists_zsmul_u3 N z).mp hz
      exact Submodule.smul_mem _ η (Submodule.subset_span (Set.mem_singleton _))
    · exact LieSubmodule.submodule_span_le_lieSpan
  have horderInt : (addOrderOf (FinitePlateau.u3 N) : ℤ) = (64 : ℤ) := by
    exact_mod_cast FinitePlateau.addOrderOf_u3_eq_sixtyFour N hN
  have hquotient :
      (Ideal.span {(addOrderOf (FinitePlateau.u3 N) : ℤ)} : Submodule ℤ ℤ) =
        (Ideal.span {(64 : ℤ)} : Submodule ℤ ℤ) := by
    rw [horderInt]
  exact ⟨
    (LinearEquiv.ofEq (FinitePlateau.terminalCyclicIdeal N).toSubmodule
      (ℤ ∙ FinitePlateau.u3 N) hspan).trans
      ((CharacterModule.intSpanEquivQuotAddOrderOf (FinitePlateau.u3 N)).trans
        ((Submodule.quotEquivOfEq _ _ hquotient).trans
          (Int.quotientSpanNatEquivZMod 64).toAddEquiv.toIntLinearEquiv))⟩

/-- **Equation `six-relations`.** These are exactly the six bracket relations
displayed immediately before the manuscript's lemma `a-order`. -/
theorem equationSixRelations (N : ℕ) (hN : 1 ≤ N) :
    (4 : ℤ) • FinitePlateau.b12 N + FinitePlateau.u2 N = 0 ∧
      (4 : ℤ) • FinitePlateau.b13 N +
          (2 : ℤ) • FinitePlateau.u3 N = 0 ∧
      -(16 : ℤ) • FinitePlateau.b12 N - FinitePlateau.u1 N = 0 ∧
      (16 : ℤ) • FinitePlateau.b23 N +
          (4 : ℤ) • FinitePlateau.u3 N = 0 ∧
      -(64 : ℤ) • FinitePlateau.b13 N -
          (2 : ℤ) • FinitePlateau.u1 N = 0 ∧
      -(64 : ℤ) • FinitePlateau.b23 N -
          (4 : ℤ) • FinitePlateau.u2 N = 0 :=
  ⟨FinitePlateau.four_b12_add_u2_eq_zero N hN,
    FinitePlateau.four_b13_add_two_u3_eq_zero N hN,
    FinitePlateau.neg_sixteen_b12_sub_u1_eq_zero N hN,
    FinitePlateau.sixteen_b23_add_four_u3_eq_zero N hN,
    FinitePlateau.neg_sixtyFour_b13_sub_two_u1_eq_zero N hN,
    FinitePlateau.neg_sixtyFour_b23_sub_four_u2_eq_zero N hN⟩

/-- **Lemma `a-order`.** In the explicit ring, `a=32u₃` and `a` has exact
additive order two, which is the direct Lean formulation of
`⟨a⟩ ≅ ℤ/2`. -/
theorem lemmaAOrder (N : ℕ) (hN : 1 ≤ N) :
    FinitePlateau.a N = (32 : ℤ) • FinitePlateau.u3 N ∧
      addOrderOf (FinitePlateau.a N) = 2 ∧
      Nonempty (FinitePlateau.exceptionalIdeal N ≃ₗ[ℤ] ZMod 2) :=
  ⟨FinitePlateau.a_eq_thirtyTwo_u3 N hN,
    FinitePlateau.addOrderOf_a_eq_two N hN,
    ⟨FinitePlateau.exceptionalIdealEquivZModTwo N hN⟩⟩

/-- **Equation `a-factorization`.** This is the exact factorization
`ι(a)=ι(c₁)ι(c₃)-ι(c₂)²` in the universal enveloping algebra. -/
theorem equationAFactorization (N : ℕ) (hN : 1 ≤ N) :
    UniversalEnvelopingAlgebra.ι ℤ (FinitePlateau.a N) =
      UniversalEnvelopingAlgebra.ι ℤ (FinitePlateau.c1 N) *
          UniversalEnvelopingAlgebra.ι ℤ (FinitePlateau.c3 N) -
        UniversalEnvelopingAlgebra.ι ℤ (FinitePlateau.c2 N) *
          UniversalEnvelopingAlgebra.ι ℤ (FinitePlateau.c2 N) :=
  FinitePlateau.iota_a_eq_c1_mul_c3_sub_c2_sq N hN

/-- **Lemma `a-height`.** The exceptional element belongs to
`δ_(2N+4)(L_N)`. -/
theorem lemmaAHeight (N : ℕ) (hN : 1 ≤ N) :
    FinitePlateau.a N ∈
      dimensionSubring ℤ (FinitePlateau.L N) (2 * N + 4) :=
  FinitePlateau.a_mem_dimensionSubring_twoN_add_four N hN

/-- **Lemma `critical-normal-form`.** The critical dimension subring is
exactly the ideal generated by the exceptional element `a`. -/
theorem lemmaCriticalNormalForm (N : ℕ) (hN : 1 ≤ N) :
    dimensionSubring ℤ (FinitePlateau.L N) (N + 4) =
      FinitePlateau.exceptionalIdeal N :=
  FinitePlateau.dimensionSubring_eq_exceptionalIdeal_of_critical_upper
    N hN (FinitePlateau.dimensionSubring_critical_le_exceptionalIdeal N hN)
      (N + 4) le_rfl (by omega)

/-- **Lemma `last-initial-form`.** The exceptional element does not belong
to the `(2N+5)`th power of the augmentation ideal. -/
theorem lemmaLastInitialForm (N : ℕ) (hN : 1 ≤ N) :
    UniversalEnvelopingAlgebra.ι ℤ (FinitePlateau.a N) ∉
      UEA.augmentationIdeal ℤ (FinitePlateau.L N) ^ (2 * N + 5) := by
  intro ha
  have hdim : FinitePlateau.a N ∈
      dimensionSubring ℤ (FinitePlateau.L N) (2 * N + 5) :=
    (mem_dimensionSubring ℤ (FinitePlateau.L N)).mpr ha
  rw [FinitePlateau.terminal_dimensionSubring_eq_bot N] at hdim
  exact FinitePlateau.a_ne_zero N hN (by simpa using hdim)

/-! ## Corollaries in the metabelian-nilpotent section -/

/-- **Corollary 5.7.** This repeats Corollary D at its proof location:
`δ_(2c-1)(L) ⊆ γ_(c+1)(L)+L''`, and in particular
`δ_5(L) ⊆ γ_4(L)`. -/
theorem corollaryFiveSeven
    (c : ℕ) (L : Type v) [LieRing L] (hc : 2 ≤ c) :
    dimensionSubring ℤ L (2 * c - 1) ≤
        lowerCentralSeries ℤ L c ⊔ LieAlgebra.derivedSeries ℤ L 2 ∧
      dimensionSubring ℤ L 5 ≤ lowerCentralSeries ℤ L 3 :=
  corollaryD c L hc

/-- **Corollary 5.8.** For a metabelian Lie ring,
`δ_(2c-1)(L) ⊆ γ_(c+1)(L)` whenever `c ≥ 2`. -/
theorem corollaryFiveEight
    (c : ℕ) (L : Type v) [LieRing L]
    (hc : 2 ≤ c) (hmeta : IsMetabelian L) :
    dimensionSubring ℤ L (2 * c - 1) ≤ lowerCentralSeries ℤ L c := by
  have h :=
    MetabelianTwoFactor.odd_dimensionSubring_le_lowerCentralSeries_sup_secondDerived
      c L hc
  rw [hmeta, sup_bot_eq] at h
  exact h

/-- **Corollary 5.9.** If `L` has nilpotency class at most `c ≥ 2`, then
`δ_(2c-1)(L) ⊆ L'' ∩ Z(L)`. -/
theorem corollaryFiveNine
    (c : ℕ) (L : Type v) [LieRing L]
    (hc : 2 ≤ c) (hclass : lowerCentralSeries ℤ L c = ⊥) :
    dimensionSubring ℤ L (2 * c - 1) ≤
      LieAlgebra.derivedSeries ℤ L 2 ⊓ LieAlgebra.center ℤ L :=
  MetabelianTwoFactor.nilpotent_odd_dimensionSubring_le_secondDerived_inf_center
    c L hc hclass

/-- **Corollary 5.10.** For every metabelian Lie ring,
`δ_ω(L)=γ_ω(L)`. -/
theorem corollaryFiveTen
    (L : Type v) [LieRing L] (hmeta : IsMetabelian L) :
    dimensionSubringOmega ℤ L = lowerCentralSeriesOmega ℤ L :=
  MetabelianTwoFactor.dimensionSubringOmega_eq_lowerCentralSeriesOmega
    L hmeta

end

